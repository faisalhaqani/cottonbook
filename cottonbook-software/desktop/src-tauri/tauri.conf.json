{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CottonBook",
  "version": "1.0.1",
  "identifier": "online.devcampsolutions.cottonbook",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "CottonBook",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Muhammad Faisal Haqani \u2014 Department of Plant Breeding and Genetics, IUB",
    "shortDescription": "Cotton breeder trait recorder",
    "longDescription": "Record cotton morphological and quantitative traits against the FSC&RD descriptor, run ANOVA, variance components, correlation, PCA, clustering, diversity and Line x Tester analysis, and export a supplementary workbook."
  }
}